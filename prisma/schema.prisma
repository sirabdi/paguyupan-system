// Prisma schema — paguyupan-system
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Models
// ============================================================

model Anggota {
  id                  Int           @id @default(autoincrement())
  nama                String
  alamat              String?       @db.Text
  noTelp              String?       @map("no_telp")
  email               String        @unique
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  passwordHash        String        @map("password_hash")
  passwordChangedAt   DateTime?     @map("password_changed_at")
  role                Role          @default(ANGGOTA)
  status              StatusAnggota @default(AKTIF)
  tanggalGabung       DateTime      @default(now()) @map("tanggal_gabung")

  iuran        Iuran[]
  news         News[]
  notifikasi   Notifikasi[]
  otpCodes     OtpCode[]
  sessions     UserSession[]
  komentar     Komentar[]
  like         Like[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("anggota")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  anggota   Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId Int      @map("anggota_id")
  codeHash  String   @map("code_hash")
  purpose   String   @default("verify_email")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([anggotaId, purpose])
  @@map("otp_code")
}

model News {
  id        Int           @id @default(autoincrement())
  judul     String
  konten    String   @db.Text
  bannerUrl String?  @map("banner_url")
  penulis   Anggota  @relation(fields: [penulisId], references: [id])
  penulisId Int      @map("penulis_id")
  komentar  Komentar[]
  like      Like[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([penulisId])
  @@index([kategori])
  @@map("news")
}

model Komentar {
  id        Int       @id @default(autoincrement())
  news      News      @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId    Int       @map("news_id")
  penulis   Anggota   @relation(fields: [penulisId], references: [id], onDelete: Cascade)
  penulisId Int       @map("penulis_id")
  konten    String    @db.Text
  parent    Komentar? @relation("KomentarReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  Int?      @map("parent_id")
  replies   Komentar[] @relation("KomentarReplies")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([newsId, parentId])
  @@map("komentar")
}

model Like {
  id        Int     @id @default(autoincrement())
  news      News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId    Int     @map("news_id")
  anggota   Anggota @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId Int     @map("anggota_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([newsId, anggotaId])
  @@map("like")
}

model Iuran {
  id           Int         @id @default(autoincrement())
  anggota      Anggota     @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId    Int         @map("anggota_id")
  periode      String
  jumlah       Decimal     @db.Decimal(12, 2)
  status       StatusIuran @default(BELUM_BAYAR)
  tanggalBayar DateTime?   @map("tanggal_bayar")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([anggotaId, periode])
  @@index([periode])
  @@map("iuran")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN
  SEKERTARIS
  BENDAHARA
  ANGGOTA
}

enum StatusAnggota {
  AKTIF
  NONAKTIF
}

enum StatusIuran {
  BELUM_BAYAR
  LUNAS
}

model Notifikasi {
  id          Int       @id @default(autoincrement())
  anggota     Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId   Int       @map("anggota_id")
  tipe        TipeNotif
  judul       String
  pesan       String    @db.Text
  dibaca      Boolean   @default(false)
  referensiId Int       @map("referensi_id")
  newsId      Int?      @map("news_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([anggotaId, tipe, referensiId])
  @@index([anggotaId, dibaca])
  @@map("notifikasi")
}

enum TipeNotif {
  IURAN_TAGIHAN
  IURAN_LUNAS
  KOMENTAR_ARTIKEL
  KOMENTAR_BALASAN
}

model UserSession {
  id        String   @id @default(cuid())
  anggota   Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId Int      @map("anggota_id")
  expiresAt DateTime @map("expires_at")
  kicked    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([anggotaId])
  @@map("user_session")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ip        String
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, createdAt])
  @@index([email, createdAt])
  @@map("login_attempt")
}

// Konfigurasi aplikasi (key-value), mis. nominal iuran bulanan default.
model Konfigurasi {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("konfigurasi")
}
