// Prisma schema — paguyupan-system
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Models
// ============================================================

model Anggota {
  id                  Int           @id @default(autoincrement())
  nama                String
  alamat              String?       @db.Text
  noTelp              String?       @map("no_telp")
  email               String        @unique
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  passwordHash        String        @map("password_hash")
  passwordChangedAt   DateTime?     @map("password_changed_at")
  role                Role          @default(ANGGOTA)
  status              StatusAnggota @default(AKTIF)
  tanggalGabung       DateTime      @default(now()) @map("tanggal_gabung")
  komunitas           Komunitas?    @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId         Int?          @map("komunitas_id")

  iuran        Iuran[]
  news         News[]
  notifikasi   Notifikasi[]
  otpCodes     OtpCode[]
  sessions     UserSession[]
  komentar     Komentar[]
  like         Like[]
  pembayaran   Pembayaran[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([komunitasId])
  @@map("anggota")
}

// OTP terikat ke akun (anggotaId) ATAU ke email (pendaftaran — akun belum ada).
model OtpCode {
  id        Int      @id @default(autoincrement())
  anggota   Anggota? @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId Int?     @map("anggota_id")
  email     String?
  ip        String?
  codeHash  String   @map("code_hash")
  purpose   String   @default("verify_email")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  percobaan Int      @default(0) // jumlah percobaan salah
  createdAt DateTime @default(now()) @map("created_at")

  @@index([anggotaId, purpose])
  @@index([email, purpose])
  @@index([ip, createdAt])
  @@map("otp_code")
}

model News {
  id          Int          @id @default(autoincrement())
  judul       String
  konten      String       @db.Text
  bannerUrl   String?      @map("banner_url")
  kategori    KategoriNews @default(BERITA)
  penulis     Anggota?     @relation(fields: [penulisId], references: [id], onDelete: SetNull)
  penulisId   Int?         @map("penulis_id")
  komunitas   Komunitas?   @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId Int?         @map("komunitas_id")
  komentar    Komentar[]
  like        Like[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([penulisId])
  @@index([kategori])
  @@index([komunitasId])
  @@map("news")
}

enum KategoriNews {
  UNDANGAN
  BERITA
  PENGUMUMAN
}

model Komentar {
  id          Int       @id @default(autoincrement())
  news        News      @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId      Int       @map("news_id")
  penulis     Anggota?  @relation(fields: [penulisId], references: [id], onDelete: SetNull)
  penulisId   Int?      @map("penulis_id")
  komunitas   Komunitas? @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId Int?       @map("komunitas_id")
  konten      String    @db.Text
  parent      Komentar? @relation("KomentarReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    Int?      @map("parent_id")
  replies     Komentar[] @relation("KomentarReplies")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([newsId, parentId])
  @@index([komunitasId])
  @@map("komentar")
}

model Like {
  id          Int       @id @default(autoincrement())
  news        News      @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId      Int       @map("news_id")
  anggota     Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId   Int       @map("anggota_id")
  komunitas   Komunitas? @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId Int?       @map("komunitas_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([newsId, anggotaId])
  @@index([komunitasId])
  @@map("like")
}

model Iuran {
  id           Int         @id @default(autoincrement())
  anggota      Anggota     @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId    Int         @map("anggota_id")
  komunitas    Komunitas?  @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId  Int?        @map("komunitas_id")
  // Jenis iuran (bulanan default / tambahan buatan admin). Null = legacy iuran bulanan.
  jenisIuran   JenisIuran? @relation(fields: [jenisIuranId], references: [id], onDelete: Cascade)
  jenisIuranId Int?        @map("jenis_iuran_id")
  periode      String
  jumlah       Decimal     @db.Decimal(12, 2)
  status       StatusIuran @default(BELUM_BAYAR)
  tanggalBayar DateTime?   @map("tanggal_bayar")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([anggotaId, periode, jenisIuranId])
  @@index([periode])
  @@index([komunitasId])
  @@index([jenisIuranId])
  @@map("iuran")
}

// Jenis iuran per komunitas.
// isDefault=true → "Iuran Bulanan" bawaan (interval 1 bulan, satu per komunitas).
// isDefault=false → iuran tambahan buatan admin (dibatasi kuota Komunitas.maxIuranTambahan).
model JenisIuran {
  id            Int        @id @default(autoincrement())
  komunitas     Komunitas  @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId   Int        @map("komunitas_id")
  nama          String
  jumlah        Decimal    @db.Decimal(12, 2)
  intervalBulan Int        @default(1) @map("interval_bulan") // tagih tiap N bulan
  isDefault     Boolean    @default(false) @map("is_default")
  aktif         Boolean    @default(true)

  iuran         Iuran[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([komunitasId])
  @@map("jenis_iuran")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  SUPERADMIN
  ADMIN
  SEKERTARIS
  BENDAHARA
  ANGGOTA
}

enum TipeKomunitas {
  RT
  RW
  BLOK
  CUSTOM
}

// Status administratif komunitas. "Kedaluwarsa" tidak disimpan —
// diturunkan dari expiredAt < sekarang (lihat lib/langganan.ts).
enum StatusKomunitas {
  MENUNGGU_PEMBAYARAN
  AKTIF
  SUSPEND
}

enum Paket {
  BASIC
  PRO
  MAX
}

enum StatusPembayaran {
  PENDING
  PAID
  EXPIRED
}

enum StatusAnggota {
  AKTIF
  NONAKTIF
}

enum StatusIuran {
  BELUM_BAYAR
  LUNAS
}

model Notifikasi {
  id          Int       @id @default(autoincrement())
  anggota     Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId   Int       @map("anggota_id")
  komunitas   Komunitas? @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId Int?       @map("komunitas_id")
  tipe        TipeNotif
  judul       String
  pesan       String    @db.Text
  dibaca      Boolean   @default(false)
  referensiId Int       @map("referensi_id")
  newsId      Int?      @map("news_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([anggotaId, tipe, referensiId])
  @@index([anggotaId, dibaca])
  @@index([komunitasId])
  @@map("notifikasi")
}

enum TipeNotif {
  IURAN_TAGIHAN
  IURAN_LUNAS
  KOMENTAR_ARTIKEL
  KOMENTAR_BALASAN
}

model UserSession {
  id        String   @id @default(cuid())
  anggota   Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId Int      @map("anggota_id")
  expiresAt DateTime @map("expires_at")
  kicked    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([anggotaId])
  @@map("user_session")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ip        String
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, createdAt])
  @@index([email, createdAt])
  @@map("login_attempt")
}

// Konfigurasi aplikasi (key-value), mis. nominal iuran bulanan default.
model Konfigurasi {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("konfigurasi")
}

model Komunitas {
  id            Int             @id @default(autoincrement())
  nama          String
  tipe          TipeKomunitas
  // Paket langganan aktif. Null = belum pernah bayar.
  paket         Paket?
  // Kuota akun (termasuk admin & pengurus) — diisi otomatis sesuai paket
  kuotaAnggota  Int             @default(20)             @map("kuota_anggota")
  status        StatusKomunitas @default(MENUNGGU_PEMBAYARAN)
  expiredAt     DateTime?       @map("expired_at")
  alamatInduk   String?         @map("alamat_induk")
  // Kuota jumlah jenis iuran TAMBAHAN yang boleh dibuat admin (selain iuran bulanan default)
  maxIuranTambahan Int          @default(3)              @map("max_iuran_tambahan")
  // Penanda email pengingat sudah dikirim untuk periode berjalan (direset saat perpanjang)
  pengingatH7At DateTime?       @map("pengingat_h7_at")
  pengingatH1At DateTime?       @map("pengingat_h1_at")

  anggota       Anggota[]
  news          News[]
  iuran         Iuran[]
  jenisIuran    JenisIuran[]
  notifikasi    Notifikasi[]
  komentar      Komentar[]
  like          Like[]
  pembayaran    Pembayaran[]

  createdAt     DateTime        @default(now())          @map("created_at")
  updatedAt     DateTime        @updatedAt               @map("updated_at")

  @@index([status, expiredAt])
  @@map("komunitas")
}

// Pembayaran langganan via Xendit Invoice.
model Pembayaran {
  id              Int              @id @default(autoincrement())
  komunitas       Komunitas        @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId     Int              @map("komunitas_id")
  dibuatOleh      Anggota?         @relation(fields: [dibuatOlehId], references: [id], onDelete: SetNull)
  dibuatOlehId    Int?             @map("dibuat_oleh_id")
  externalId      String           @unique @map("external_id")
  xenditInvoiceId String?          @unique @map("xendit_invoice_id")
  invoiceUrl      String?          @db.Text @map("invoice_url")
  paket           Paket
  durasiBulan     Int              @map("durasi_bulan")
  harga           Decimal          @db.Decimal(12, 2)
  status          StatusPembayaran @default(PENDING)
  metode          String?
  // Hari tambahan hasil konversi sisa nilai paket lama (saat ganti paket)
  bonusHari       Int              @default(0) @map("bonus_hari")
  periodeMulai    DateTime?        @map("periode_mulai")
  periodeSelesai  DateTime?        @map("periode_selesai")
  kedaluwarsaAt   DateTime         @map("kedaluwarsa_at") // batas bayar invoice
  paidAt          DateTime?        @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([komunitasId, status])
  @@index([status, kedaluwarsaAt])
  @@map("pembayaran")
}
