// Prisma schema — paguyupan-system
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Models
// ============================================================

model Anggota {
  id                  Int           @id @default(autoincrement())
  nama                String
  alamat              String?       @db.Text
  noTelp              String?       @map("no_telp")
  email               String        @unique
  emailVerifiedAt     DateTime?     @map("email_verified_at")
  passwordHash        String        @map("password_hash")
  passwordChangedAt   DateTime?     @map("password_changed_at")
  role                Role          @default(ANGGOTA)
  status              StatusAnggota @default(AKTIF)
  tanggalGabung       DateTime      @default(now()) @map("tanggal_gabung")
  komunitas           Komunitas?    @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId         Int?          @map("komunitas_id")

  iuran        Iuran[]
  news         News[]
  notifikasi   Notifikasi[]
  otpCodes     OtpCode[]
  sessions     UserSession[]
  komentar     Komentar[]
  like         Like[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([komunitasId])
  @@map("anggota")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  anggota   Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId Int      @map("anggota_id")
  codeHash  String   @map("code_hash")
  purpose   String   @default("verify_email")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([anggotaId, purpose])
  @@map("otp_code")
}

model News {
  id          Int          @id @default(autoincrement())
  judul       String
  konten      String       @db.Text
  bannerUrl   String?      @map("banner_url")
  kategori    KategoriNews @default(BERITA)
  penulis     Anggota?     @relation(fields: [penulisId], references: [id], onDelete: SetNull)
  penulisId   Int?         @map("penulis_id")
  komunitas   Komunitas?   @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId Int?         @map("komunitas_id")
  komentar    Komentar[]
  like        Like[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([penulisId])
  @@index([kategori])
  @@index([komunitasId])
  @@map("news")
}

enum KategoriNews {
  UNDANGAN
  BERITA
  PENGUMUMAN
}

model Komentar {
  id          Int       @id @default(autoincrement())
  news        News      @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId      Int       @map("news_id")
  penulis     Anggota?  @relation(fields: [penulisId], references: [id], onDelete: SetNull)
  penulisId   Int?      @map("penulis_id")
  komunitas   Komunitas? @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId Int?       @map("komunitas_id")
  konten      String    @db.Text
  parent      Komentar? @relation("KomentarReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    Int?      @map("parent_id")
  replies     Komentar[] @relation("KomentarReplies")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([newsId, parentId])
  @@index([komunitasId])
  @@map("komentar")
}

model Like {
  id          Int       @id @default(autoincrement())
  news        News      @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId      Int       @map("news_id")
  anggota     Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId   Int       @map("anggota_id")
  komunitas   Komunitas? @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId Int?       @map("komunitas_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([newsId, anggotaId])
  @@index([komunitasId])
  @@map("like")
}

model Iuran {
  id           Int         @id @default(autoincrement())
  anggota      Anggota     @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId    Int         @map("anggota_id")
  komunitas    Komunitas?  @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId  Int?        @map("komunitas_id")
  periode      String
  jumlah       Decimal     @db.Decimal(12, 2)
  status       StatusIuran @default(BELUM_BAYAR)
  tanggalBayar DateTime?   @map("tanggal_bayar")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([anggotaId, periode])
  @@index([periode])
  @@index([komunitasId])
  @@map("iuran")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  SUPERADMIN
  ADMIN
  SEKERTARIS
  BENDAHARA
  ANGGOTA
}

enum TipeKomunitas {
  RT
  RW
  BLOK
  CUSTOM
}

enum StatusKomunitas {
  TRIAL
  AKTIF
  SUSPEND
}

enum StatusAnggota {
  AKTIF
  NONAKTIF
}

enum StatusIuran {
  BELUM_BAYAR
  LUNAS
}

model Notifikasi {
  id          Int       @id @default(autoincrement())
  anggota     Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId   Int       @map("anggota_id")
  komunitas   Komunitas? @relation(fields: [komunitasId], references: [id], onDelete: Cascade)
  komunitasId Int?       @map("komunitas_id")
  tipe        TipeNotif
  judul       String
  pesan       String    @db.Text
  dibaca      Boolean   @default(false)
  referensiId Int       @map("referensi_id")
  newsId      Int?      @map("news_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([anggotaId, tipe, referensiId])
  @@index([anggotaId, dibaca])
  @@index([komunitasId])
  @@map("notifikasi")
}

enum TipeNotif {
  IURAN_TAGIHAN
  IURAN_LUNAS
  KOMENTAR_ARTIKEL
  KOMENTAR_BALASAN
}

model UserSession {
  id        String   @id @default(cuid())
  anggota   Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId Int      @map("anggota_id")
  expiresAt DateTime @map("expires_at")
  kicked    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([anggotaId])
  @@map("user_session")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ip        String
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, createdAt])
  @@index([email, createdAt])
  @@map("login_attempt")
}

// Konfigurasi aplikasi (key-value), mis. nominal iuran bulanan default.
model Konfigurasi {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("konfigurasi")
}

model Komunitas {
  id            Int             @id @default(autoincrement())
  nama          String
  tipe          TipeKomunitas
  kode          String?         @unique
  kuotaAnggota  Int             @default(50)             @map("kuota_anggota")
  status        StatusKomunitas @default(TRIAL)
  durasiHari    Int?            @map("durasi_hari")
  expiredAt     DateTime?       @map("expired_at")
  alamatInduk   String?         @map("alamat_induk")

  anggota       Anggota[]
  news          News[]
  iuran         Iuran[]
  notifikasi    Notifikasi[]
  komentar      Komentar[]
  like          Like[]

  createdAt     DateTime        @default(now())          @map("created_at")
  updatedAt     DateTime        @updatedAt               @map("updated_at")

  @@map("komunitas")
}
