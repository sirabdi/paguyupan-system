// Prisma schema — paguyupan-system
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Models
// ============================================================

model Anggota {
  id            Int           @id @default(autoincrement())
  nama          String
  alamat        String?       @db.Text
  noTelp        String?       @map("no_telp")
  email         String        @unique
  passwordHash  String        @map("password_hash")
  role          Role          @default(ANGGOTA)
  status        StatusAnggota @default(AKTIF)
  tanggalGabung DateTime      @default(now()) @map("tanggal_gabung")

  iuran        Iuran[]
  news         News[]
  notifikasi   Notifikasi[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("anggota")
}

model News {
  id        Int      @id @default(autoincrement())
  judul     String
  konten    String   @db.Text
  bannerUrl String?  @map("banner_url")
  penulis   Anggota  @relation(fields: [penulisId], references: [id])
  penulisId Int      @map("penulis_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([penulisId])
  @@map("news")
}

model Iuran {
  id           Int         @id @default(autoincrement())
  anggota      Anggota     @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId    Int         @map("anggota_id")
  periode      String
  jumlah       Decimal     @db.Decimal(12, 2)
  status       StatusIuran @default(BELUM_BAYAR)
  tanggalBayar DateTime?   @map("tanggal_bayar")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([anggotaId, periode])
  @@index([periode])
  @@map("iuran")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN
  SEKERTARIS
  BENDAHARA
  ANGGOTA
}

enum StatusAnggota {
  AKTIF
  NONAKTIF
}

enum StatusIuran {
  BELUM_BAYAR
  LUNAS
}

model Notifikasi {
  id          Int       @id @default(autoincrement())
  anggota     Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  anggotaId   Int       @map("anggota_id")
  tipe        TipeNotif
  judul       String
  pesan       String    @db.Text
  dibaca      Boolean   @default(false)
  referensiId Int       @map("referensi_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([anggotaId, tipe, referensiId])
  @@index([anggotaId, dibaca])
  @@map("notifikasi")
}

enum TipeNotif {
  IURAN_TAGIHAN
  IURAN_LUNAS
}
